<?xml version="1.0" encoding="utf-8"?>
<!--
    Middle-earth — OP Middle-earth map script (spec 143).
    The map registers in Advanced Setup (FrontEnd UpdateDatabase on the Maps
    table) and ships the Lua script to the map generator (InGame ImportFiles).
    Design mirrors the Vinterhav mod (spec 140); see docs/civ6-map-script-reference.md
    and docs/achievements-middleearth.md for design context.
-->
<Mod id="MIDDLEEARTH_MAP" version="2">
    <Properties>
        <Name>Middle-earth Map</Name>
        <Teaser>OP Middle-earth map script (106x66, no wrap)</Teaser>
        <Description>Hand-shaped Middle-earth. The human starts as Gondor on a hand-engraved OP homeland; Rohan, Lothlórien, Erebor, the Shire, Mordor, Harad and Rhûn get scripted starts; Mount Doom burns in Mordor and Aman waits on a separate western continent.</Description>
        <Authors> Project Author </Authors>
        <CompatibleVersions>2.0</CompatibleVersions>
    </Properties>

    <Dependencies/>
    <References/>

    <FrontEndActions>
        <UpdateDatabase id="MIDDLEEARTH_CONFIG">
            <Properties><LoadOrder>1000003</LoadOrder></Properties>
            <File>Configuration/Config.xml</File>
        </UpdateDatabase>
        <UpdateText id="MIDDLEEARTH_TEXT">
            <Properties><LoadOrder>1000003</LoadOrder></Properties>
            <File>Configuration/ConfigText.xml</File>
        </UpdateText>
    </FrontEndActions>

    <InGameActions>
        <ImportFiles id="MIDDLEEARTH_IMPORT">
            <Properties><LoadOrder>1000002</LoadOrder></Properties>
            <File>Maps/MiddleEarth.lua</File>
        </ImportFiles>
        <AddGameplayScripts id="MIDDLEEARTH_START_UNITS">
            <Properties><LoadOrder>1000001</LoadOrder></Properties>
            <File>Gameplay/MiddleEarthStartUnits.lua</File>
        </AddGameplayScripts>
        <AddGameplayScripts id="MIDDLEEARTH_START_GOLD">
            <Properties><LoadOrder>1000000</LoadOrder></Properties>
            <File>Gameplay/MiddleEarthStartGold.lua</File>
        </AddGameplayScripts>
    </InGameActions>

    <Files>
        <File>Configuration/Config.xml</File>
        <File>Configuration/ConfigText.xml</File>
        <File>Maps/MiddleEarth.lua</File>
        <File>Gameplay/MiddleEarthStartUnits.lua</File>
        <File>Gameplay/MiddleEarthStartGold.lua</File>
    </Files>
</Mod>