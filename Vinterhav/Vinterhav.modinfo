<?xml version="1.0" encoding="utf-8"?>
<!--
    Vinterhav — fantasy-Scandinavia map script (spec 140).
    The map registers in Advanced Setup (FrontEnd UpdateDatabase on the Maps
    table) and ships the Lua script to the map generator (InGame ImportFiles).
    See PLAN.md / Plan V2.md / docs/civ6-map-script-reference.md for design.
-->
<Mod id="VINTERHAV_MAP" version="4">
    <Properties>
        <Name>Vinterhav Map</Name>
        <Teaser>OP fantasy-Scandinavia map script (84x54, no wrap)</Teaser>
        <Description>A hand-shaped fantasy-Scandinavia. The human player starts on a hand-engraved OP homeland; AI hemispheres are cold and resource-lean.</Description>
        <Authors> Project Author </Authors>
        <CompatibleVersions>2.0</CompatibleVersions>
    </Properties>

    <Dependencies/>
    <References/>

    <FrontEndActions>
        <UpdateDatabase id="VINTERHAV_CONFIG">
            <Properties><LoadOrder>1000003</LoadOrder></Properties>
            <File>Configuration/Config.xml</File>
        </UpdateDatabase>
        <UpdateText id="VINTERHAV_TEXT">
            <Properties><LoadOrder>1000003</LoadOrder></Properties>
            <File>Configuration/ConfigText.xml</File>
        </UpdateText>
    </FrontEndActions>

    <InGameActions>
        <ImportFiles id="VINTERHAV_IMPORT">
            <Properties><LoadOrder>1000002</LoadOrder></Properties>
            <File>Maps/Vinterhav.lua</File>
        </ImportFiles>
        <AddGameplayScripts id="VINTERHAV_START_UNITS">
            <Properties><LoadOrder>1000001</LoadOrder></Properties>
            <File>Gameplay/VinterhavStartUnits.lua</File>
        </AddGameplayScripts>
        <AddGameplayScripts id="VINTERHAV_START_GOLD">
            <Properties><LoadOrder>1000000</LoadOrder></Properties>
            <File>Gameplay/VinterhavStartGold.lua</File>
        </AddGameplayScripts>
    </InGameActions>

    <Files>
        <File>Configuration/Config.xml</File>
        <File>Configuration/ConfigText.xml</File>
        <File>Maps/Vinterhav.lua</File>
        <File>Gameplay/VinterhavStartUnits.lua</File>
        <File>Gameplay/VinterhavStartGold.lua</File>
    </Files>
</Mod>