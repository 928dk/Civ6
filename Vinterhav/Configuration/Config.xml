        <Row Domain="StandardMaps" File="Vinterhav.lua"
             Name="LOC_MAP_VINTERHAV_NAME"
             Description="LOC_MAP_VINTERHAV_DESCRIPTION"
             DisableWorldWrap="1"
             SortIndex="45"/>
    </Maps>
</GameInfo>